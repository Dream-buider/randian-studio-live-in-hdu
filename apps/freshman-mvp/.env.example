# 复制为 .env.local 后填写。不要把 .env.local 上传或发到聊天中。
PORT=3210
HOST=0.0.0.0

# 留空时进入演示模式；填写后调用 DeepSeek V4。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：兼容 Tavily 风格 POST /search 的搜索接口。
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_API_KEY=

PRESET_THRESHOLD=0.52
KNOWLEDGE_THRESHOLD=0.38
INTENT_CONFIDENCE=0.78
REQUEST_TIMEOUT_MS=20000
