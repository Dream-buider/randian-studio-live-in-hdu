server {
  listen 80;
  listen [::]:80;
  server_name liveinhdu.cn www.liveinhdu.cn;
  return 301 https://liveinhdu.cn$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name liveinhdu.cn;

  # Install operator-owned certificate files before enabling this server block.
  ssl_certificate /etc/nginx/ssl/liveinhdu.cn/fullchain.pem;
  ssl_certificate_key /etc/nginx/ssl/liveinhdu.cn/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  # Defense in depth: these routes stay private even though Nginx connects from loopback.
  location = /admin { return 403; }
  location ^~ /admin/ { return 403; }
  location = /api/admin { return 403; }
  location ^~ /api/admin/ { return 403; }
  location = /api/reviews { return 403; }
  location ^~ /api/reviews/ { return 403; }

  location / {
    proxy_pass http://127.0.0.1:3212;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";
    proxy_cookie_flags live_in_hdu_roommate secure httponly samesite=strict;
  }
}
