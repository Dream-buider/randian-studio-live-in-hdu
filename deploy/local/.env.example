# Copy to .env.local only after Phase B prerequisites pass.
# Keep all large runtime material under the approved D-drive root.
LIVE_IN_HDU_REQUESTED_ROOT=D:/
LIVE_IN_HDU_RUNTIME_ROOT=D:/Star/LIVE_IN_HDU_RUNTIME
POSTGRES_DATA_DIR=D:/Star/LIVE_IN_HDU_RUNTIME/phase-b/postgres
WEKNORA_DATA_DIR=D:/Star/LIVE_IN_HDU_RUNTIME/phase-b/weknora
SEARXNG_DATA_DIR=D:/Star/LIVE_IN_HDU_RUNTIME/phase-b/searxng
OLLAMA_MODELS=D:/Star/LIVE_IN_HDU_RUNTIME/phase-b/ollama-models

LIVE_IN_HDU_DB_NAME=live_in_hdu
LIVE_IN_HDU_DB_USER=live_in_hdu
LIVE_IN_HDU_DB_PASSWORD=
LIVE_IN_HDU_DB_PORT=5433

WEKNORA_VERSION=0.7.0
WEKNORA_APP_PORT=8080
WEKNORA_API_KEY=
WEKNORA_DOCUMENT_KB_ID=
WEKNORA_FAQ_KB_ID=

SEARXNG_BIND=127.0.0.1
SEARXNG_PORT=8888
SEARXNG_SECRET=

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
