FROM live-in-hdu/weknora-builder:0.7.0 AS builder

FROM node:20-slim AS node_runtime

FROM debian:12.12-slim

WORKDIR /app

ARG APK_MIRROR_ARG
ARG APT_OPTIONS="-o Acquire::Retries=10 -o Acquire::http::Pipeline-Depth=0 -o Acquire::Queue-Mode=access"

RUN useradd -m -s /bin/bash appuser

RUN apt-get $APT_OPTIONS update && \
    apt-get $APT_OPTIONS install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN if [ -n "$APK_MIRROR_ARG" ]; then \
        sed -i "s@deb.debian.org@${APK_MIRROR_ARG}@g" /etc/apt/sources.list.d/debian.sources; \
    fi

RUN apt-get $APT_OPTIONS update && \
    apt-get $APT_OPTIONS install -y --no-install-recommends \
        postgresql-client default-mysql-client tzdata sed curl bash vim wget gosu && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get $APT_OPTIONS update && \
    apt-get $APT_OPTIONS install -y --no-install-recommends \
        build-essential libsqlite3-0 \
        python3 python3-pip python3-dev libffi-dev libssl-dev && \
    python3 -m pip install --break-system-packages --upgrade pip setuptools wheel && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get $APT_OPTIONS update && \
    apt-get $APT_OPTIONS install -y --no-install-recommends ffmpeg && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY --from=node_runtime /usr/local /usr/local

RUN mkdir -p /home/appuser/.local/bin && \
    uv_installed=false; \
    for attempt in 1 2 3 4 5; do \
        if curl -LsSf --retry 3 --retry-all-errors --connect-timeout 20 \
            https://astral.sh/uv/install.sh -o /tmp/uv-install.sh && \
            CARGO_HOME=/home/appuser/.cargo UV_INSTALL_DIR=/home/appuser/.local/bin sh /tmp/uv-install.sh; then \
            uv_installed=true; \
            break; \
        fi; \
        sleep 5; \
    done && \
    test "$uv_installed" = true && \
    rm -f /tmp/uv-install.sh && \
    chown -R appuser:appuser /home/appuser && \
    ln -sf /home/appuser/.local/bin/uvx /usr/local/bin/uvx && \
    chmod +x /usr/local/bin/uvx

RUN mkdir -p /data/files && \
    chown -R appuser:appuser /app /data/files

COPY --from=builder /go/bin/migrate /usr/local/bin/
COPY --from=builder /app/yanyiwu/ /go/pkg/mod/github.com/yanyiwu/

COPY --from=builder /app/config ./config
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/migrations ./migrations
COPY --from=builder /app/dataset/samples ./dataset/samples
COPY --from=builder /app/skills/preloaded ./skills/preloaded
COPY --from=builder /app/skills/preloaded ./skills/_builtin
COPY --from=builder /root/.duckdb /home/appuser/.duckdb
COPY --from=builder /app/WeKnora .
COPY --from=builder /app/scripts/docker-entrypoint.sh ./scripts/docker-entrypoint.sh

RUN chmod +x ./scripts/*.sh

EXPOSE 8080

ENTRYPOINT ["./scripts/docker-entrypoint.sh"]
CMD ["./WeKnora"]
